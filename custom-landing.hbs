{{!< default}}
{{#page}}

    <div class="is-landing-template">
    {{!-- Přidá třídu na body, aby CSS mohl skrýt menu (Ghost nepřidává custom šablony do body_class) --}}
    <script>document.body.classList.add('is-landing-page');</script>
    <article class="gh-article mt-0">
        <header class="container mb-6 text-center md:mb-8 gh-header">
            <h1 class="max-w-md mx-auto mb-2 text-3xl font-bold sm:leading-snug lg:max-w-3xl lg:text-5xl gh-title font-display">{{title}}</h1>
            {{#if custom_excerpt}}
                <p class="max-w-lg mx-auto mt-4 text-base font-text">{{custom_excerpt}}</p>
            {{/if}}
        </header>

        {{!-- Feature image --}}
        {{#if feature_image}}
            <figure class="container mt-2 text-center md:mb-8 md:mt-10 gh-feature-image max-sm:p-0">
                <picture>
                    <img srcset="{{img_url feature_image size="post-full-s" format="webp"}} 412w,
                                 {{img_url feature_image size="card-720" format="webp"}} 720w,
                                 {{img_url feature_image size="post-full-m" format="webp"}} 750w,
                                 {{img_url feature_image size="card-960" format="webp"}} 960w,
                                 {{img_url feature_image size="post-full" format="webp"}} 1216w,
                                 {{img_url feature_image size="post-full-m-x2" format="webp"}} 1500w,
                                 {{img_url feature_image size="post-full-x2" format="webp"}} 2432w"
                         sizes="(max-width: 639px) 100vw, (max-width: 1279px) 92vw, 1216px" src="{{img_url feature_image size="post-full"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" class="w-full max-sm:rounded-none max-sm:w-full rounded-3xl" decoding="async" fetchpriority="high" />
                </picture>
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}

        <div class="container prose prose-lg md:prose-xl gh-content gh-canvas max-w-none">
            {{{content}}}
        </div>
    </article>
    </div>

{{/page}}

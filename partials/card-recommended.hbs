{{!--
Karta doporučeného článku pod článkem a na 404 („Nespěcháš? Tak si dej tohle…“).
Karta je vidět i bez najetí myší (krémové pozadí, okraj, jemný stín) – na telefonu hover není, dřív se karta
slévala s bílou stránkou. Na širší obrazovce fotka vlevo a text vpravo, ať tři doporučení nezaberou tři obrazovky.
Výzva „Přisedni →“ je jen vizuální, odkazem je celá karta (poslední <a> přes celou plochu).
--}}

<article class="post-card {{post_class}} kd-rec{{#unless access}} post-access-{{visibility}}{{/unless}}">
    {{#if feature_image}}
        <div class="kd-rec__foto">
            {{!-- Rámeček na telefonu 16:9 na celou šířku, od 640 px sloupec 40 % karty vysoký jako text – sizes s rezervou na object-cover --}}
            <img srcset="{{img_url feature_image size="card-480" format="webp"}} 480w,
                         {{img_url feature_image size="card-720" format="webp"}} 720w,
                         {{img_url feature_image size="card-960" format="webp"}} 960w,
                         {{img_url feature_image size="card-1200" format="webp"}} 1200w"
                 sizes="(max-width: 639px) calc(110vw - 32px), 540px"
                 src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy" decoding="async">

            {{#unless access}}
                <span class="kd-rec__zamek">
                    {{> "icons/lock"}}
                    {{#has visibility="members"}}{{t "Members only"}}{{/has}}
                    {{#has visibility="paid"}}{{t "Premium only"}}{{/has}}
                    {{#has visibility="tiers"}}{{t "Premium only"}}{{/has}}
                </span>
            {{/unless}}
        </div>
    {{/if}}

    <div class="kd-rec__text">
        <h2 class="no-toc not-prose kd-rec__nadpis font-display">{{title}}</h2>

        {{#if excerpt}}
            <p class="kd-rec__uryvek">{{excerpt}}</p>
        {{/if}}

        {{#match @custom.meta_display "!=" "Hide all meta"}}
            <footer class="kd-rec__meta macaw-post-meta">
                {{> "kd-pribeh-karta"}}
            </footer>
        {{/match}}

        <span class="kd-rec__vyzva font-display" aria-hidden="true">Přisedni <span class="kd-rec__sipka">&#8594;</span></span>
    </div>

    <a class="kd-rec__odkaz" href="{{url}}" title="{{t "Read more about:"}} {{title}}"><span class="sr-only">{{title}}</span></a>
</article>

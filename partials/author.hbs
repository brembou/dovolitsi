<section class="kd-autorka relative p-8 m-auto text-center max-md:max-w-sm rounded-3xl bg-white/50 max-w-content" data-aos="fade-in" data-aos-duration="500" data-aos-delay="150">

    {{!-- Martina ve smyčce z jejího vlastního videa (11. 10. 2026, vybrala sama): úsek 5 s zpomalený na polovinu (zdroj 60 fps,
         takže bez trhání), jemný „závoj“ (měkké světlo, teplý tón), ořez na obličej, bez zvuku, konec prolnutý se začátkem
         (ffmpeg xfade) – smyčka 10 s bez škubnutí. Fotka (poster) = první snímek videa.
         Do té doby je vidět fotka (poster). Video se stáhne až těsně před tím, než blok dojede na obrazovku – blok je pod článkem,
         načtení stránky nebrzdí. Pouští se všem, i při vypnutých animacích v systému a šetření dat (Martina 11. 10. 2026:
         pohyb je pomalý a jemný, 216 kB). --}}
    <div class="kd-autorka__foto">
        <a href="/jako-ja/" data-rel="author-photo">
            <video class="kd-autorka__video" poster="{{asset "kudrlinky/martina.webp"}}" width="160" height="160" muted loop playsinline preload="none"
                   aria-label="Martina Nakládalová" data-kd-autorka-video>
                <source data-src="{{asset "kudrlinky/martina.mp4"}}" type="video/mp4">
            </video>
        </a>
    </div>

    <div class="flex flex-col mt-4 gap-y-4">

        <header class="macaw-author-header">
            <h4 class="text-3xl font-bold text-gray-900 font-display"><a href="/jako-ja/" data-rel="author-name">Tak tohle jsem já</a></h4>

            {{!-- Text bloku jako by to Martina říkala kamarádce (varianta B, schválila 11. 10. 2026) --}}
            <p class="kd-autorka__text">
                Martina. Máma, manželka a ženská, která se pořád učí, že si smí něco dovolit.
                <a href="/jako-ja/">Kdo jsem</a>, <a href="/protoze-muzes/">proč píšu</a>
                a <a href="/co-o-mne-rikaji/">co o mně říkají holky</a>, najdeš kousek odsud.
            </p>
        </header>

        {{#if bio}}
            <div class="max-w-lg mx-auto mb-2 text-base font-normal leading-relaxed">{{bio}}</div>
        {{/if}}

        {{#if instagram}}
            <p class="kd-autorka__text">
                Na <a href="https://www.instagram.com/{{instagram}}" target="_blank" rel="noopener noreferrer">Instagramu</a>{{#if facebook}}
                a <a href="https://www.facebook.com/{{facebook}}" target="_blank" rel="noopener noreferrer">Facebooku</a>{{/if}} toho vykecám ještě víc. Zastav se.
            </p>
        {{else if facebook}}
            <p class="kd-autorka__text">
                Na <a href="https://www.facebook.com/{{facebook}}" target="_blank" rel="noopener noreferrer">Facebooku</a> toho vykecám ještě víc. Zastav se.
            </p>
        {{/if}}
    </div>
</section>

<script>
    (function () {
        var v = document.querySelector('[data-kd-autorka-video]');
        if (!v || v.dataset.kdStart) return;
        v.dataset.kdStart = '1';
        if (!('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
            if (!entries.some(function (e) { return e.isIntersecting; })) return;
            io.disconnect();
            v.querySelectorAll('source[data-src]').forEach(function (s) { s.src = s.dataset.src; });
            v.load();
            var p = v.play();
            if (p && p.catch) p.catch(function () { /* bez automatického přehrání zůstane fotka */ });
        }, { rootMargin: '300px 0px' });
        io.observe(v);
    })();
</script>

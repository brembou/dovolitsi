{{!< default}}
<div class="container {{#match @custom.post_list_display "!=" "Big list"}} max-w-[920px] {{/match}}">

    <h2 class="pt-10 md:pt-0 pb-2 text-base font-bold leading-none tracking-widest text-gray-900 uppercase border-b featured-title font-display border-b-gray-200 {{#match @custom.post_list_display "!=" "Big list"}} mb-2 {{/match}}">{{t "Latest posts"}}</h2>

    {{!-- ZMĚNA (kudrlinky – další místa): roční období pro třešně v oddělovačích (CSS v index.css, [data-kd-obdobi]).
         Nastaví se dřív, než prohlížeč vykreslí první kartu, takže ikona se nikdy nevymění před očima. --}}
    <script>(function(m){document.currentScript.parentNode.setAttribute('data-kd-obdobi',m>=2&&m<=4?'jaro':m>=5&&m<=7?'leto':m>=8&&m<=10?'podzim':'zima')})(new Date().getMonth())</script>
    <div class="grid grid-cols-1 divide-y divide-solid gh-feed">

        {{#foreach posts}}

            {{#match @custom.post_list_display "==" "Big list"}}
                {{> "card" }} {{!-- partials/card.hbs --}}
            {{/match}}

            {{#match @custom.post_list_display "==" "Small list"}}
                {{> "card-small" }} {{!-- partials/card-small.hbs --}}
            {{/match}}

            {{#match @custom.post_list_display "==" "Minimal list"}}
                {{> "card-minimal" }} {{!-- partials/card-minimal.hbs --}}
            {{/match}}

        {{/foreach}}

    </div>

    {{!-- Pagination pro JS uživatele - skryje se, pokud JS není dostupný --}}
    <div class="js-pagination">
        {{pagination}}
    </div>

    {{!-- Fallback pagination pro uživatele bez JS --}}
    <noscript>
        <div class="gh-pagination">
            {{pagination}}
        </div>
    </noscript>

</div>
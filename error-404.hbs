{{!< default}}

{{!--

There are two error files in this theme, one for 404s and one for all other errors.
This file is the former, and handles all 404 Page Not Found errors.

The 404 error is the most common error that a visitor might see, for example when
following a broken link


--}}

<div class="container">
    {{!-- Prázdná lavička pod třešní (kudrlinka 5, předloha Claude Design). Místo na kresbu je rezervované (poměr 6:5),
         kresba se stáhne až po vykreslení stránky; bez JS zůstane jen text a tlačítko. --}}
    <section class="mt-6 error-message flex flex-col items-center text-center gap-[18px] px-[22px] py-10">
        <div class="kd-404 w-full max-w-[420px] aspect-[6/5]" aria-hidden="true" data-kd-src="{{asset "kudrlinky/lavicka-jaro.svg"}}"></div>
        {{!-- {{message}} je od Ghostu vždy anglicky („Page not found“), proto Martinin text z locales/cs.json --}}
        <h1 class="font-display font-bold text-[28px] leading-[1.25] max-w-[440px] [text-wrap:balance] error-description">{{t "Page not found"}}</h1>
        <a class="error-link font-display uppercase bg-acc text-white leading-none rounded-3xl px-6 h-[48px] tracking-wider flex items-center justify-center text-sm hover:opacity-80 transition-opacity macaw-button" href="{{@site.url}}">{{t "Go to the front page"}} →</a>
    </section>
    <script>
        (function () {
            var box = document.querySelector('.kd-404');
            var m = new Date().getMonth();
            var season = m >= 2 && m <= 4 ? 'jaro' : m >= 5 && m <= 7 ? 'leto' : m >= 8 && m <= 10 ? 'podzim' : 'zima';
            window.addEventListener('load', function () {
                fetch(box.getAttribute('data-kd-src').replace('lavicka-jaro.svg', 'lavicka-' + season + '.svg'))
                    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
                    .then(function (svg) { box.innerHTML = svg; })
                    .catch(function (e) { console.warn('kudrlinky: lavička 404', e); });
            });
        })();
    </script>

    {{#get "posts" filter="visibility:public" limit="3" as |latest|}}
        {{#if latest}}
            <section class="mt-20 mb-10">
                <h2 class="pb-3 mb-16 text-lg md:text-base font-bold leading-none tracking-widest text-gray-900 uppercase border-b featured-title font-display">
                    Nebo si přisedni k něčemu novému…
                </h2>
                <div class="grid grid-cols-1 gap-6 md:gap-8 gh-feed recommended-posts">
                    {{#foreach latest}}
                        {{> "card-recommended"}}
                    {{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
</div>

{{!-- Chybné odkazy do Plausible (vkládá ho GTM). Fronta plausible.q zachytí událost, i když skript ještě nedoběhl.
     path = adresa, která vrátila 404; odkud = celá adresa stránky se špatným odkazem (Plausible jinak ukáže jen doménu
     a odkazy z vlastního webu nepočítá vůbec) --}}
<script>
    window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) };
    plausible('404', { props: { path: document.location.pathname, odkud: document.referrer || '(přímý přístup)' } });
</script>
